{
  "buildCommand": "cd \"FieldFlow frontend\" && npm install --include=dev && npm run build",
  "outputDirectory": "FieldFlow frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
