{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "FieldFlow frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/FieldFlow frontend/(.*)",
      "dest": "/FieldFlow frontend/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/FieldFlow frontend/assets/$1"
    },
    {
      "src": "/favicon.svg",
      "dest": "/FieldFlow frontend/favicon.svg"
    },
    {
      "src": "/(.*)",
      "dest": "/FieldFlow frontend/index.html"
    }
  ]
}
